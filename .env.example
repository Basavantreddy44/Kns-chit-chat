# ------------------------------------------------------------------
# KNS Chit-Chat — environment configuration
# Copy this file to `.env.development` (local dev) or `.env.production`
# and fill in the values. Never commit real secrets.
# ------------------------------------------------------------------

# Which authentication provider the app uses:
#   mock -> src/services/mockAuthService.js  (development only, no backend)
#   api  -> src/services/apiAuthService.js   (real backend)
#   supabase -> src/services/supabaseAuthService.js  (see docs/SUPABASE_SETUP.md)
VITE_AUTH_MODE=mock

# Supabase project settings (used when VITE_AUTH_MODE=supabase).
# Use the PUBLISHABLE key (sb_publishable_...). Never put the secret key in a
# VITE_ variable: those are bundled into the page and visible to everyone.
VITE_SUPABASE_URL=https://jmckebhtdqobedoegqzp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_3jpnRSnhUs6TiJcyv5MXmw_HJJINzGg

# Base URL of your backend API (used when VITE_AUTH_MODE=api).
# The login request is sent to: POST {VITE_API_BASE_URL}/auth/login
VITE_API_BASE_URL=http://localhost:4000/api

# Development-only demo account for the MOCK service.
# These are read at runtime — nothing is hardcoded in source code.
VITE_MOCK_USER_EMAIL=
VITE_MOCK_USER_USERNAME=
VITE_MOCK_USER_PASSWORD=
VITE_MOCK_USER_NAME=
